  {"type":"eval","code":"const S=window.__ck.s;const flips=[];let prev=null;for(const r of S){const k=r.st.join('|');if(k!==prev){flips.push({t:r.t,st:k,d:r.d});prev=k;}}JSON.stringify({phase:'after-move',samples:S.length,maxAnchorDist:[0,1,2].map(i=>Math.max(...S.map(r=>r.d[i]))),over:S.filter(r=>r.d.some(x=>x>3.41)).length,stateFlips:flips.length,flips:flips.slice(0,16),last:S[S.length-1]})"},
  {"type":"eval","code":"clearInterval(window.__ckT);JSON.stringify(__echoes.events.filter(e=>e.type==='ally_regroup').slice(-6))"}
