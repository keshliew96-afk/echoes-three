  "code": "(()=>{const E=window.__echoes;const P=E.hud.portraits();const cells=[...document.querySelectorAll('.hud-port')];return P.map((p,i)=>{const cs=getComputedStyle(cells[i].querySelector('.hud-port-tile'));const ic=getComputedStyle(cells[i].querySelector('.hud-port-ident'));const hp=getComputedStyle(cells[i].querySelector('.hud-port-hp'));return {i:p.index,cls:p.classId,state:p.state,sel:p.selected,hov:p.hover,num:p.numeral,inner:p.innerBorder,innerCol:p.innerColor,fillImg:p.fillImage,track:p.trackColor,trackOutline:p.trackOutline,tileBorder:cs.borderTopColor,ident:ic.display+' '+ic.borderTopColor,hpRim:hp.borderTopColor,hpW:p.hpWidth,keyBox:p.keyBox,numBox:p.numBox,tileBox:p.tileBox};});})()"
 }
