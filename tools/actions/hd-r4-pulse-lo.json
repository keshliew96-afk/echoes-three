 },
 {
  "type": "wait",
  "ms": 500
 },
 {
  "type": "eval",
  "code": "(()=>{const E=window.__echoes;const P=E.state().party;const f=(i)=>P.find(q=>(q.partyIndex??0)===i).id;E.cmd('setHp',f(1),0.40);E.cmd('setHp',f(2),0.15);E.cmd('setHp',f(3),0);E.hud.freeze(0.5);E.hud.hover(0,true);return 1;})()"
