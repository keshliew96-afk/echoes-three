[
  {"type":"eval","code":"(()=>{const e=window.__echoes;let r={};try{r.teleport=e.cmd('teleport',3,3)}catch(err){r.teleportErr=String(err)}try{r.setHp=e.cmd('setHp',1,0.5)}catch(err){r.setHpErr=String(err)}try{r.killAll=e.cmd('killAllEnemies')}catch(err){r.killAllErr=String(err)}return r})()"},
