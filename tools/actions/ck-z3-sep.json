[
  {"type":"eval","code":"(()=>{window.__ck={s:[]};window.__ckT=setInterval(()=>{const v=__echoes.cmd('allyState');const st=__echoes.state();const p=[st.party[0].x,st.party[0].z];window.__ck.s.push({t:__echoes.tick,ne:st.enemies.length,dp:v.allies.map(a=>+Math.hypot(a.x-p[0],a.z-p[1]).toFixed(3))});},33);return 'on';})()"},
  {"type":"wait","ms":18000},
  {"type":"eval","code":"(()=>{clearInterval(window.__ckT);const S=window.__ck.s.filter(r=>r.ne>0);const mins=S.map(r=>Math.min(...r.dp));const s=mins.slice().sort((a,b)=>a-b);return JSON.stringify({combatSamples:S.length,minEver:+s[0].toFixed(3),median:+s[Math.floor(s.length/2)].toFixed(3),under030:mins.filter(x=>x<0.3).length,under060:mins.filter(x=>x<0.6).length,pctUnder060:+(100*mins.filter(x=>x<0.6).length/Math.max(1,mins.length)).toFixed(1)});})()"}
