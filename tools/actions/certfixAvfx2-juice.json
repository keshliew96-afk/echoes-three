 {
  "type": "eval",
  "code": "(async()=>{const E=window.__echoes;const t0=performance.now();const k0=E.tick;while(performance.now()-t0<90000){try{if(window.__a2.ev.filter(e=>e.T==='death').length>=2)return {ok:true,tick:E.tick,waitedTicks:E.tick-k0,ms:Math.round(performance.now()-t0),kb:window.__a2.ev.filter(e=>e.T==='knockback').slice(0,8),shakes:window.__a2.ev.filter(e=>e.T==='screenshake').slice(0,8),deaths:window.__a2.ev.filter(e=>e.T==='death').length};}catch(err){}await new Promise(r=>setTimeout(r,8));}return {ok:false,tick:E.tick,waitedTicks:E.tick-k0,ms:Math.round(performance.now()-t0),kb:window.__a2.ev.filter(e=>e.T==='knockback').slice(0,8),shakes:window.__a2.ev.filter(e=>e.T==='screenshake').slice(0,8),deaths:window.__a2.ev.filter(e=>e.T==='death').length}})()"
 },
 {
