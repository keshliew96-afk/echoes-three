  "code": "(()=>{const E=window.__echoes;const s=E.state();return {tag:'juice',vfx:(s=>Object.assign({},s.vfx,{numerals:s.vfx.numerals??null,decals:s.vfx.decals??null,scorch:s.vfx.scorch??null,particles:s.vfx.particles??null}))(s),shakeEvents:window.__a2.ev.filter(e=>e.T==='screenshake').length,kbEvents:window.__a2.ev.filter(e=>e.T==='knockback').length}})()"
 },
 {
  "type": "eval",
  "code": "(()=>{const E=window.__echoes;const m={};for(const e of window.__a2.ev)m[e.T]=(m[e.T]||0)+1;return {tick:E.tick,fps:+E.fps.toFixed(1),counts:m,total:window.__a2.ev.length}})()"
 }
