 {"type":"eval","code":"(()=>{window.__sleep=(ms)=>new Promise(r=>setTimeout(r,ms));window.__press=(c)=>{window.dispatchEvent(new KeyboardEvent('keydown',{code:c,bubbles:true}));window.dispatchEvent(new KeyboardEvent('keyup',{code:c,bubbles:true}));};window.__move=async(x,y)=>{window.dispatchEvent(new MouseEvent('mousemove',{clientX:x,clientY:y,bubbles:true,cancelable:true}));await window.__sleep(35);return window.__echoes.state().party[0].aim;};window.__dir=async(sx,sy)=>{const a=await window.__move(sx,sy);const p=__echoes.state().party[0];const dx=a.x-p.x,dz=a.z-p.z;const L=Math.hypot(dx,dz);return{ux:dx/L,uz:dz/L,p,aim:a};};window.__ev=(t0,types)=>__echoes.events.filter(e=>e.tick>=t0&&(!types||types.includes(e.type)));window.__nums=()=>[...document.querySelectorAll('.dmg-num')].filter(n=>getComputedStyle(n).visibility!=='hidden'&&parseFloat(getComputedStyle(n).opacity)>0.05).map(n=>({t:n.textContent,color:getComputedStyle(n).color,size:getComputedStyle(n).fontSize,pos:n.getBoundingClientRect()}));window.__park=()=>{__echoes.cmd('placeAlly',1,-10.5,-6.5);__echoes.cmd('placeAlly',2,-9.5,-6.5);__echoes.cmd('placeAlly',3,-8.5,-6.5);};window.__equip=(ids)=>{const slots=ids.map(id=>id?{id,remaining:0}:null);while(slots.length<4)slots.push(null);return __echoes.cmd('restoreSkillState',{slots,override:null});};return 'lib';})()"}
