  {"type":"eval","code":"(()=>{const s=__echoes.state();const a=s.party_ai.allies;__echoes.cmd('setHp',a[0].id,0);__echoes.cmd('setHp',a[1].id,0);return{downed3:false,hps:__echoes.state().party.map(p=>p.hp)}})()"},
  {"type":"wait","ms":500},
